# Copy to .env.local for local development, or add these in Vercel → Settings → Environment Variables.
# The Client ID is public (it is sent to Spotify's authorize page), so this is safe to commit/build.
# Never add a Client Secret: Solo uses PKCE and has no backend.

# Optional. When set, visitors can press "Connect Spotify" without pasting a Client ID.
# Leave empty to use the bring-your-own-Client-ID setup screen instead.
VITE_SPOTIFY_CLIENT_ID=

# Optional. Defaults to <current-origin>/callback. Set this only when the public
# URL differs from the URL the browser sees (custom domain, proxy, preview alias).
# It must exactly match a Redirect URI in the Spotify developer dashboard.
VITE_SPOTIFY_REDIRECT_URI=
