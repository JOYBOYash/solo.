# Copy to .env.local for local development, or add these in your host's
# environment (for Vercel: Settings → Environment Variables) and redeploy.
# Everything here is compiled into the static bundle at build time.
# Never add a Spotify Client Secret: Solo uses PKCE and has no backend.

# Shared YouTube Data API key. Lets every visitor search without setup.
# Supported names: VITE_YOUTUBE_API_KEY, YOUTUBE_API_KEY, GOOGLE_API_KEY, YT_API_KEY.
# It is public in the static bundle and its free quota is shared by all visitors
# (10,000 units/day; a search costs 100, trending costs 1). Restrict it to your
# website and YouTube Data API v3 in Google Cloud.
# Leave empty for local development: the dev server offers a bring-your-own-key
# screen. A production build shows a clean unavailable state instead.
VITE_YOUTUBE_API_KEY=

# Shared Spotify app Client ID. Lets visitors press "Connect Spotify" without
# pasting a Client ID. Supported names: VITE_SPOTIFY_CLIENT_ID, SPOTIFY_CLIENT_ID.
# The Client ID is public by design. Development Mode apps allow 5 users.
# Leave empty for local development's bring-your-own-Client-ID setup.
VITE_SPOTIFY_CLIENT_ID=

# Optional. Defaults to <current-origin>/callback. Set this only when the public
# URL differs from the URL the browser sees (custom domain, proxy, preview alias).
# It must exactly match a Redirect URI in the Spotify developer dashboard.
VITE_SPOTIFY_REDIRECT_URI=

# Self-hosted builds only. Set to 1 to let visitors paste their own YouTube key
# and Spotify Client ID. Leave unset for a public launch: production builds then
# never show credential forms.
VITE_ALLOW_PERSONAL_KEYS=
